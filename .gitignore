# Vendored upstream — fetch on demand for local dev (git clone per sources/<source>.repos); the
# Docker build fetches its own copy. Never committed: this wrapper stays source-free; the pin
# files under sources/ are the truth.
/src/

# Launcher staging (rendered per-instance main.conf written by mavlink-router-up)
/var/

# Python
__pycache__/
*.py[cod]

# IDE / local
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
.env
.env.local

# Local tooling state (Claude Code, etc.)
.claude/

# A rig checkout for CI / the deployment tests (RIG_CLI=.rig/rig)
/.rig/
