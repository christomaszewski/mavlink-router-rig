#!/usr/bin/env bash
# mavlink-router-up <config.yaml> [up [-d] | down | status | logs [args] | config | ...]
#
# Bring up ONE mavlink-router instance from ONE generic rig config (the single source of truth).
# Reads the config, derives the instance identity (compose project = an inherited
# COMPOSE_PROJECT_NAME — rig owns it — or mavlink-router_<name> standalone), renders the UPSTREAM
# router's main.conf INI, and runs `docker compose`. It SELECTS + PARAMETERIZES static compose
# files — it never generates one: one serial overlay joins per UART endpoint in the config, the
# logging overlay only when logging.enabled is true.
#
#   mavlink-router-up config/fcu.yaml              # up (foreground)
#   mavlink-router-up config/fcu.yaml up -d        # detached
#   mavlink-router-up config/fcu.yaml status       # docker compose ps
#   mavlink-router-up config/fcu.yaml logs -f
#   mavlink-router-up config/fcu.yaml down
#   mavlink-router-up config/fcu.yaml config       # render the merged compose
#   mavlink-router-up /any/host/path/fcu.yaml up -d    # config from anywhere (rig)
#
# rig's image-plan verbs (read-only: nothing is rendered, started or pulled):
#   mavlink-router-up <config> images              # YAML list of the image refs `up` would run
#   mavlink-router-up <config> runtime-images      # the same set as rig's version-1 JSON inventory
# and when rig exports RIG_RUNTIME_IMAGE_PINS (a replay/simulation session), `up` starts exactly
# the image IDs rig validated, never pulling — see tools/runtime_images.py.
#
# Multiple routers = run it per config; each is its own compose project, so instances never
# collide (mind the host ports — network_mode: host). This repo does NOT depend on rig (one-way;
# see rigging.yaml).
set -euo pipefail
REPO="$(cd "$(dirname "$0")" && pwd)"
PYTHON="${MAVROUTER_PYTHON:-python3}"
COMPOSE="$REPO/docker/compose/compose.deploy.yaml"

CONFIG="${1:?usage: mavlink-router-up <config.yaml> [up [-d]|down|status|logs|config|...]}"
shift || true
[ -f "$CONFIG" ] || { echo "mavlink-router-up: config not found: $CONFIG" >&2; exit 1; }
CONFIG_ABS="$(cd "$(dirname "$CONFIG")" && pwd)/$(basename "$CONFIG")"

if ! docker compose version >/dev/null 2>&1; then
  echo "mavlink-router-up: needs the Docker Compose v2 plugin ('docker compose')" >&2
  exit 1
fi

# Image-plan queries. The one image this service runs depends on the image env alone
# (MAVROUTER_IMAGE / RIG_IMAGE_REGISTRY / RIG_IMAGE_TAG) — never on the instance config, and the
# serial/logging overlays add no service — so the query reads the base compose with placeholders
# and does not parse the config at all: rig plans a fleet artifact from configs whose per-vehicle
# identity is still unresolved, and a query must not write the staged main.conf either.
case "${1:-}" in
  images|runtime-images)
    export MAVROUTER_CONF_HOST=/dev/null MAVROUTER_CONF_SHA256=none
    export MAVROUTER_NAME=image-plan MAVROUTER_HEALTH_PORT=0
    export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-mavlink-router_image-plan}"
    exec "$PYTHON" "$REPO/tools/runtime_images.py" "$1" -f "$COMPOSE"
    ;;
esac

# config -> validated instance identity + derived tokens (SERVICE / NAME / TYPE / DEVICE[_N] /
# HEALTH_PORT / LOGGING), with the router config rendered to its host staging path (CONF_HOST, one
# file per instance; CONF_SHA256 is its content hash). ONE renderer pass, captured before the
# eval so a rejected config stops right here with the renderer's own message. Values are
# shell-quoted by the renderer, so the eval is safe for device paths.
TOKENS="$("$PYTHON" "$REPO/tools/render_conf.py" --stage "$REPO/var/run" "$CONFIG_ABS")"
eval "$TOKENS"
PROJECT="${SERVICE}_${NAME}"

# Compose env: this instance's rendered config, name, and health port. The deploy image is
# resolved by the compose file itself (MAVROUTER_IMAGE override -> RIG_IMAGE_REGISTRY -> local
# mavlink_router:latest), so a standalone run needs no rig and no registry; export
# MAVROUTER_IMAGE to force a specific image. The content hash rides along as a container label:
# compose only recreates a container whose DEFINITION changed, and an edited main.conf behind
# the same mount path is not that — without the label `up` would leave the router running its
# old config.
export MAVROUTER_CONF_HOST="$CONF_HOST"
export MAVROUTER_CONF_SHA256="$CONF_SHA256"
export MAVROUTER_NAME="$NAME"
export MAVROUTER_HEALTH_PORT="$HEALTH_PORT"

FILES=(-f "$COMPOSE")
if [ "$TYPE" = "serial" ]; then
  # One fixed overlay per serial device, in uart_endpoints order: the first UART's is
  # compose.deploy.serial.yaml (MAVROUTER_DEVICE), the Nth's compose.deploy.serial<N>.yaml
  # (MAVROUTER_DEVICE_<N>). The renderer caps the UART count at the overlays that exist.
  export MAVROUTER_DEVICE="${DEVICE:?serial config needs uart_endpoints[0].device}"
  FILES+=(-f "$REPO/docker/compose/compose.deploy.serial.yaml")
  for slot in 2 3 4; do
    token="DEVICE_$slot"
    [ -n "${!token:-}" ] || break
    export "MAVROUTER_DEVICE_$slot=${!token}"
    FILES+=(-f "$REPO/docker/compose/compose.deploy.serial$slot.yaml")
  done
fi
if [ "$LOGGING" = "1" ]; then
  FILES+=(-f "$REPO/docker/compose/compose.deploy.logging.yaml")
fi

# Verbs: `status` -> `ps`; everything else is forwarded to `docker compose` verbatim. No args = up.
ARGS=("$@")
[ ${#ARGS[@]} -eq 0 ] && ARGS=(up)
[ "${ARGS[0]}" = "status" ] && ARGS=(ps "${ARGS[@]:1}")

# rig owns the compose project name (it exports COMPOSE_PROJECT_NAME per call); honor it when
# inherited, fall back to <service>_<name> standalone. NEVER pass -p — overriding the
# orchestrator's project name orphans the containers from `rig status`/`rig down`.
export COMPOSE_PROJECT_NAME="${COMPOSE_PROJECT_NAME:-$PROJECT}"

echo "mavlink-router-up: project=$COMPOSE_PROJECT_NAME type=$TYPE conf=$CONF_HOST" >&2
# A rig session pinned this instance's images (set, even if empty, means "pinned"): hand `up` to
# the helper, which re-checks the active image set against the pins and starts the frozen model.
if [ "${ARGS[0]}" = "up" ] && [ "${RIG_RUNTIME_IMAGE_PINS+x}" ]; then
  exec "$PYTHON" "$REPO/tools/runtime_images.py" pinned-up "${FILES[@]}" -- "${ARGS[@]:1}"
fi
exec docker compose "${FILES[@]}" "${ARGS[@]}"
