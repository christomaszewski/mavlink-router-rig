# Minimal production image for upstream mavlink-router, VENDORED AT BUILD TIME. Self-contained
# two-stage build (modeled on upstream's examples/Dockerfile.alpine): the build stage obtains the
# pinned source and compiles it (meson/ninja, release); the runtime stage ships only the
# mavlink-routerd binary on alpine + libstdc++.
#
# NO `# syntax=` directive, on purpose: naming a frontend image makes every build — a fully
# cached one included — resolve it on Docker Hub, which is exactly what `rig build --offline`
# cannot do. Everything used here (multi-stage, RUN --mount=type=bind,from=<stage>) is in the
# frontend built into BuildKit.
#
# MAVROUTER_URL / MAVROUTER_REF come from tools/build_image.sh, which resolves them from
# sources/<source>.repos (MAVROUTER_SOURCE=upstream|fork, default in sources/DEFAULT). The
# defaults below mirror sources/upstream.repos (tools/test_contract.py holds them to it) so a bare
#   docker build -f docker/Dockerfile.runtime -t mavlink_router:latest .
# still builds the pinned upstream — whatever sources/DEFAULT says; only the build script reads it.
ARG MAVROUTER_URL=https://github.com/mavlink-router/mavlink-router.git
ARG MAVROUTER_REF=2362c620f483cef1edd574fb962a373a288e4b9e

# ---- source stage -----------------------------------------------------------
# Empty by default: the build stage then clones MAVROUTER_URL at MAVROUTER_REF itself. Under rig,
# tools/build_image.sh passes `--build-context mavrouter-src=$RIG_BUILD_SOURCES/<source>`, which
# REPLACES this stage with the pinned tree rig exported from its local git mirror (submodules
# included, no .git) — the build then never touches a git remote, so it also works offline.
FROM scratch AS mavrouter-src

# ---- build stage ------------------------------------------------------------
FROM alpine:3 AS build
ARG MAVROUTER_URL
ARG MAVROUTER_REF
# bash: upstream's tools/meson-vcs-tag.sh (the --version stamp) is a bash script.
RUN apk add --no-cache bash gcc g++ git pkgconf meson ninja linux-headers

WORKDIR /workspace
# Clone path — full clone (not shallow): upstream's tools/meson-vcs-tag.sh embeds `git describe`
# into the binary's --version output, which needs tag history; the repo is small.
# Exported-tree path — there is no .git to describe, and upstream's script would stamp the
# literal "VERSION", so the stamp script is replaced by one that prints the pinned ref (the
# first 12 characters: a short SHA for a SHA pin, the tag itself for a tag pin). That script
# only feeds the version string; no router source is touched on either path.
# The mavlink C library submodule is REQUIRED either way — the tree does not compile without it.
RUN --mount=type=bind,from=mavrouter-src,target=/mnt/mavrouter-src \
    if [ -f /mnt/mavrouter-src/meson.build ]; then \
      cp -a /mnt/mavrouter-src src \
      && printf '#!/bin/sh\necho "%.12s"\n' "${MAVROUTER_REF}" > src/tools/meson-vcs-tag.sh \
      && chmod +x src/tools/meson-vcs-tag.sh; \
    else \
      git clone "${MAVROUTER_URL}" src \
      && git -C src checkout --detach "${MAVROUTER_REF}" \
      && git -C src submodule update --init --recursive; \
    fi \
 && if [ ! -f src/modules/mavlink_c_library_v2/ardupilotmega/mavlink.h ]; then \
      echo "ERROR: the mavlink_c_library_v2 submodule is missing from the source tree" >&2; exit 1; \
    fi

# -Dsystemdsystemunitdir: 'auto' asks pkg-config for systemd, absent on alpine — pin the path so
# configure succeeds (nothing is installed there; we only ship the binary).
RUN meson setup build src --buildtype=release -Dsystemdsystemunitdir=/usr/lib/systemd/system \
 && ninja -C build

# ---- runtime stage ----------------------------------------------------------
FROM alpine:3 AS runtime
ARG MAVROUTER_URL
ARG MAVROUTER_REF
# libstdc++: the one shared lib the binary needs beyond musl. musl-utils: ldd for the gate below.
# netcat-openbsd: the healthcheck's TCP probe (busybox nc has no reliable -z).
RUN apk add --no-cache libstdc++ musl-utils netcat-openbsd

COPY --from=build /workspace/build/src/mavlink-routerd /usr/bin/mavlink-routerd
# Gate: the shipped binary must resolve ALL its shared libs against exactly what this stage
# installed — catches a new upstream link dependency at image-build time (CI) instead of as an
# exec failure on the vehicle. (--version goes through the argv-error exit path upstream, so it
# is printed for the build log but not used as a gate.)
RUN gaps="$(ldd /usr/bin/mavlink-routerd | grep 'not found' || true)" \
 && if [ -n "$gaps" ]; then \
      echo "ERROR: mavlink-routerd has unresolved shared libraries:"; echo "$gaps"; exit 1; \
    fi \
 && (/usr/bin/mavlink-routerd --version || true)

COPY --chmod=0755 docker/entrypoints/entrypoint.sh /usr/local/bin/entrypoint.sh
COPY --chmod=0755 docker/entrypoints/healthcheck.sh /usr/local/bin/healthcheck.sh

# Provenance: which source (upstream vs fork) and which exact rev this image was built from —
# `docker image inspect` answers "what is this vehicle actually running?".
LABEL org.opencontainers.image.title="mavlink_router" \
      org.opencontainers.image.source="${MAVROUTER_URL}" \
      org.opencontainers.image.revision="${MAVROUTER_REF}"

# The router starts fast (no sensor handshake) — short start-period; the probe is a local TCP
# connect (or pidof when the TCP server is disabled), see healthcheck.sh.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 CMD ["/usr/local/bin/healthcheck.sh"]
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
