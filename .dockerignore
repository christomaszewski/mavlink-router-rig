# Keep the Docker build context small + reproducible. The runtime image build needs only
# docker/entrypoints/ (COPYed) — the build stage clones the pinned source itself (url/ref arrive
# as build args from tools/build_image.sh), so never the host's vendored src/ nor any local state.
.git/
.github/
.claude/
/src/
/var/
**/__pycache__/
*.pyc
